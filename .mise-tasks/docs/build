#!/usr/bin/env bash
#MISE description="Put the website at /, the explorer at /explorer and the web fonts at /fonts in dist"
#MISE depends=["website:build", "font:fetch"]
#MISE dir="{{config_root}}"
set -euo pipefail

rm -rf dist
mkdir -p dist
cp -R target/website/. dist/
cp -R target/vendor dist/vendor
# The explorer page names Monaco from beside it.
mv dist/vendor/monaco dist/explorer/monaco
cp -R target/fonts dist/fonts
