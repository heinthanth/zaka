# Secret that opens website/zaka_web_ui_common/assets/fonts/PDA10BurmeseMono-Regular.ttf.age at build time.
# Leave it blank to build the explorer without PDA10 Burmese Mono.
# New secrets can be generated with `mise run font:secret` if needed.
ZAKA_PDA_FONT_SECRET=

# The address the site is served from, as https://zaka-lang.org: the
# share tags (og:image, canonical, ...) start with it. Leave it blank to serve
# on this machine; a build for the web needs it.
ZAKA_SITE_ORIGIN=
