# Secret that opens website/zaka_web_ui_common/assets/fonts/PDA10BurmeseMono-Regular.ttf.age at build time.
# Leave it blank to build the explorer without PDA10 Burmese Mono.
# New secrets can be generated with `mise run font:secret` if needed.
ZAKA_PDA_FONT_SECRET=

# The address the site is served from, as https://zaka-lang.org: the
# share tags (og:image, canonical, ...) start with it. Left blank, mise sets
# http://localhost:8000; a build for the web needs it.
ZAKA_SITE_ORIGIN=

# Cloudflare Pages, for `mise run pages:publish`: an API token that can edit
# Pages, the account ID, and the name of the Pages project.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
