{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "zaka",
      "camelcase": "Zaka",
      "scope": "source.zaka",
      "path": ".",
      "file-types": ["zaka", "zk"],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Zaka grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/zaka-lang/zaka"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
