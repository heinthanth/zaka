<?xml version="1.0" encoding="utf-8"?>
<!-- Zaka text and plain lists in the debuggers of Windows: text shows as the
     string of its octets, read as UTF-8, and a plain list as its cells. Each
     is a struct of three words, cells, count and room, as the CodeView of
     zakac names them; a plain list is list<cell> there. A native build for
     the MSVC ABI hands this file to link.exe, which puts it in the PDB. -->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="text">
    <DisplayString>"{cells,[count]s8b}"</DisplayString>
    <StringView>cells,[count]s8</StringView>
    <Expand>
      <Item Name="count">count</Item>
      <Item Name="room">room</Item>
    </Expand>
  </Type>
  <Type Name="list&lt;*&gt;">
    <DisplayString>{{ count={count} }}</DisplayString>
    <Expand>
      <Item Name="room">room</Item>
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>cells</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
</AutoVisualizer>
