# The headers here include two that a build writes: zaka_checks.h, for each
# build, and zaka_runtime.h, from the Rust of the runtime. `mise run c:mock-headers`
# writes a build of hello into target/c-headers, where the editor finds both.
CompileFlags:
  Add: [-xc, -std=c11, -I../../../target/c-headers]
