; zakac asm listing v1, platform 64 bits
texts
  t0 "မင်္ဂလာပါ"

fn f0 နှစ်ဆတိုးပြီးပေါင်း (params 3) -> isize
locals
  l0 က isize
  l1 ခ isize
  l2 ဂ isize
     0  local_addr l0        ; က
     1  local_addr l0        ; က
     2  load isize
     3  push 2:isize
     4  mul
     5  store isize
     6  local_addr l1        ; ခ
     7  local_addr l1        ; ခ
     8  load isize
     9  push 2:isize
    10  mul
    11  store isize
    12  local_addr l2        ; ဂ
    13  local_addr l2        ; ဂ
    14  load isize
    15  push 2:isize
    16  mul
    17  store isize
    18  local_addr l0        ; က
    19  load isize
    20  local_addr l1        ; ခ
    21  load isize
    22  add
    23  local_addr l2        ; ဂ
    24  load isize
    25  add
    26  ret

fn f1 ပျမ်းမျှ (params 2) -> f64
locals
  l0 က f32
  l1 ခ i8
     0  local_addr l0        ; က
     1  load f32
     2  local_addr l1        ; ခ
     3  load i8
     4  convert f32
     5  add
     6  push 2.0:f32
     7  div
     8  convert f64
     9  ret

fn f2 နှုတ်ဆက် (params 0)
     0  print_text t0
     1  ret

fn f3 ပရိုဂရမ် (params 0)
     0  call f2              ; နှုတ်ဆက်
     1  push 1:isize
     2  push 2:isize
     3  push 3:isize
     4  call f0              ; နှစ်ဆတိုးပြီးပေါင်း
     5  print
     6  ret

fn f4 main (params 0)
     0  call f3              ; ပရိုဂရမ်
     1  ret
