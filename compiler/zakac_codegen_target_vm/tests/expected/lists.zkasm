; zakac asm listing v1, platform 64 bits
seqs
  s0 isize[3] [1:isize, 2:isize, 3:isize]
  s1 isize[3] [4:isize, 5:isize, 6:isize]

fn f0 ပေါင်း (params 1) -> isize
locals
  l0 ကိန်းများ isize[3]&
  l1 အဖြေ isize
  l2 န isize
     0  local_addr l1        ; အဖြေ
     1  push 0:isize
     2  store isize
     3  local_addr l2        ; န
     4  push 0:isize
     5  store isize
     6  local_addr l2        ; န
     7  load isize
     8  push 2:isize
     9  gt
    10  jump_if_true L1
L0:
    11  local_addr l1        ; အဖြေ
    12  local_addr l1        ; အဖြေ
    13  load isize
    14  local_ref l0         ; ကိန်းများ
    15  local_addr l2        ; န
    16  load isize
    17  ptr_add 8
    18  load isize
    19  add
    20  store isize
    21  push 2:usize
    22  local_addr l2        ; န
    23  load isize
    24  convert usize
    25  wrap sub
    26  push 1:usize
    27  lt
    28  jump_if_true L1
    29  local_addr l2        ; န
    30  local_addr l2        ; န
    31  load isize
    32  push 1:isize
    33  wrap add
    34  store isize
    35  jump L0
L1:
    36  local_addr l1        ; အဖြေ
    37  load isize
    38  ret

fn f1 ပရိုဂရမ် (params 0)
locals
  l0 က isize[3]
  l1 ခ isize[3]
  l2 ဂ isize[3]
  l3 ဇယား isize[3][2]
  l4 ညွှန်း isize[3]*
  l5 ပ isize*
  l6 %dup isize[3]
  l7 %list isize[3]
     0  local_addr l0        ; က
     1  zero isize[3]
     2  local_addr l1        ; ခ
     3  zero isize[3]
     4  local_addr l2        ; ဂ
     5  seq_addr s0
     6  blit isize[3]
     7  local_addr l2        ; ဂ
     8  push 0:usize
     9  ptr_add 8
    10  push 10:isize
    11  store isize
    12  local_addr l2        ; ဂ
    13  push 2:usize
    14  index 3 from 1
    15  ptr_add 8
    16  load isize
    17  print
    18  push 3:usize
    19  print
    20  local_addr l2        ; ဂ
    21  print_list isize[3]
    22  local_addr l0        ; က
    23  local_addr l2        ; ဂ
    24  blit isize[3]
    25  local_addr l0        ; က
    26  local_addr l2        ; ဂ
    27  list_eq isize[3]
    28  print
    29  local_addr l1        ; ခ
    30  local_addr l0        ; က
    31  list_eq isize[3]
    32  not
    33  print
    34  local_addr l3        ; ဇယား
    35  zero isize[3][2]
    36  local_addr l3        ; ဇယား
    37  push 1:usize
    38  ptr_add 24
    39  push 2:usize
    40  ptr_add 8
    41  push 9:isize
    42  store isize
    43  local_addr l3        ; ဇယား
    44  push 0:usize
    45  ptr_add 24
    46  local_addr l2        ; ဂ
    47  blit isize[3]
    48  local_addr l3        ; ဇယား
    49  print_list isize[3][2]
    50  local_addr l4        ; ညွှန်း
    51  local_addr l2        ; ဂ
    52  store isize[3]*
    53  local_addr l4        ; ညွှန်း
    54  load isize[3]*
    55  push 1:usize
    56  ptr_add 8
    57  push 20:isize
    58  store isize
    59  local_addr l5        ; ပ
    60  local_addr l2        ; ဂ
    61  push 0:usize
    62  ptr_add 8
    63  store isize*
    64  local_addr l5        ; ပ
    65  load isize*
    66  push 2:isize
    67  ptr_add 8
    68  load isize
    69  print
    70  local_addr l6        ; %dup
    71  local_addr l2        ; ဂ
    72  blit isize[3]
    73  local_addr l6        ; %dup
    74  call f0              ; ပေါင်း
    75  print
    76  local_addr l7        ; %list
    77  seq_addr s1
    78  blit isize[3]
    79  local_addr l7        ; %list
    80  call f0              ; ပေါင်း
    81  print
    82  ret

fn f2 main (params 0)
     0  call f1              ; ပရိုဂရမ်
     1  ret
