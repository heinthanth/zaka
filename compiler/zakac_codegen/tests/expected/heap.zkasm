    11  print
    12  global_addr g1       ; ဒုတိယ
    13  load isize
    14  print
    15  global_addr g2       ; ဆံ့နိုင်ရေ
    16  push 4:usize
    17  store usize
    18  global_addr g3       ; အရေအတွက်
    19  push 0:usize
    20  store usize
    21  global_addr g4       ; စာရင်း
    22  push 0x0:ptr
    23  store *isize
    24  global_addr g4       ; စာရင်း
    25  global_addr g2       ; ဆံ့နိုင်ရေ
    26  load usize
    27  alloc 8
    28  store *isize
    29  global_addr g4       ; စာရင်း
    30  load *isize
    31  push 0x0:ptr
    32  eq
    33  jump_if_false L0
    34  print_text t0
L0:
    35  global_addr g5       ; ကိန်း
    36  push 1:isize
    37  store isize
    38  global_addr g5       ; ကိန်း
    39  load isize
