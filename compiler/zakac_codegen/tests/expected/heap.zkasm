    67  global_addr g5       ; ကိန်း
    68  load isize
    69  global_addr g5       ; ကိန်း
    70  load isize
    71  mul
    72  store isize
    73  global_addr g3       ; အရေအတွက်
    74  global_addr g3       ; အရေအတွက်
