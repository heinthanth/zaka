texts
  t0 "နေရာ မရပါ"

fn f0 လဲလှယ် (params 2)
locals
  l0 က *isize
  l1 ခ *isize
  l2 ယာယီ isize
     0  local_addr l2        ; ယာယီ
     1  local_addr l0        ; က
     2  load *isize
     3  load isize
     4  store isize
     5  local_addr l0        ; က
     6  load *isize
     7  local_addr l1        ; ခ
     8  load *isize
     9  load isize
    10  store isize
    11  local_addr l1        ; ခ
    12  load *isize
    13  local_addr l2        ; ယာယီ
    14  load isize
    15  store isize
    16  ret

fn f1 main (params 0)
     0  global_addr g0       ; ပထမ
     1  push 1:isize
     2  store isize
     3  global_addr g1       ; ဒုတိယ
     4  push 2:isize
     5  store isize
     6  global_addr g0       ; ပထမ
     7  global_addr g1       ; ဒုတိယ
     8  call f0              ; လဲလှယ်
     9  global_addr g0       ; ပထမ
