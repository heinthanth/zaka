; zakac asm listing v1, platform 64 bits
texts
  t0 "မင်္ဂလာပါ"

fn f0 နှစ်ဆတိုးပြီးပေါင်း (params 3) -> isize
locals
  l0 က isize
  l1 ခ isize
  l2 ဂ isize
  l3 ရလဒ် isize
     0  local_addr l3        ; ရလဒ်
     1  push 0:isize
     2  store isize
     3  local_addr l0        ; က
     4  local_addr l0        ; က
     5  load isize
     6  push 2:isize
     7  mul
     8  store isize
     9  local_addr l1        ; ခ
    10  local_addr l1        ; ခ
    11  load isize
    12  push 2:isize
    13  mul
    14  store isize
    15  local_addr l2        ; ဂ
    16  local_addr l2        ; ဂ
    17  load isize
    18  push 2:isize
    19  mul
    20  store isize
    21  local_addr l0        ; က
    22  load isize
    23  local_addr l1        ; ခ
    24  load isize
    25  add
    26  local_addr l2        ; ဂ
    27  load isize
    28  add
    29  ret

fn f1 ပျမ်းမျှ (params 2) -> f64
locals
  l0 က f32
  l1 ခ i8
  l2 ရလဒ် f64
     0  local_addr l2        ; ရလဒ်
     1  push 0.0:f64
     2  store f64
     3  local_addr l2        ; ရလဒ်
     4  local_addr l0        ; က
     5  load f32
     6  local_addr l1        ; ခ
     7  load i8
     8  convert f32
     9  add
    10  push 2.0:f32
    11  div
    12  convert f64
    13  store f64
    14  local_addr l2        ; ရလဒ်
    15  load f64
    16  ret

fn f2 နှုတ်ဆက် (params 0)
     0  print_text t0
     1  ret

fn f3 main (params 0)
     0  call f2              ; နှုတ်ဆက်
     1  push 1:isize
     2  push 2:isize
     3  push 3:isize
     4  call f0              ; နှစ်ဆတိုးပြီးပေါင်း
     5  print
     6  ret
