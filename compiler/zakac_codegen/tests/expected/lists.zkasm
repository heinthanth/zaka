; zakac asm listing v1, platform 64 bits
globals
  g0 က [3]isize
  g1 ခ [3]isize
  g2 ဂ [3]isize
  g3 ဇယား [2][3]isize
  g4 ညွှန်း &*[3]isize
  g5 ပ &*isize

fn f0 ပေါင်း (params 1) -> isize
locals
  l0 ကိန်းများ [3]isize
  l1 ရလဒ် isize
  l2 န isize
     0  local_addr l1        ; ရလဒ်
     1  push 0:isize
     2  store isize
     3  local_addr l2        ; န
     4  push 0:isize
     5  store isize
     6  local_addr l2        ; န
     7  load isize
     8  push 2:isize
     9  gt
    10  jump_if_true L1
L0:
    11  local_addr l1        ; ရလဒ်
    12  local_addr l1        ; ရလဒ်
    13  load isize
    14  local_addr l0        ; ကိန်းများ
    15  local_addr l2        ; န
    16  load isize
    17  ptr_add 8
    18  load isize
    19  add
    20  store isize
    21  push 2:usize
    22  local_addr l2        ; န
    23  load isize
    24  convert usize
    25  sub
    26  push 1:usize
    27  lt
    28  jump_if_true L1
    29  local_addr l2        ; န
    30  local_addr l2        ; န
    31  load isize
    32  push 1:isize
    33  add
    34  store isize
    35  jump L0
L1:
    36  local_addr l1        ; ရလဒ်
    37  load isize
    38  ret

fn f1 main (params 0)
locals
  l0 %list [3]isize
     0  global_addr g0       ; က
     1  zero [3]isize
     2  global_addr g1       ; ခ
     3  zero [3]isize
     4  global_addr g2       ; ဂ
     5  push 1:isize
     6  store isize
     7  global_addr g2       ; ဂ
     8  push 1:usize
     9  ptr_add 8
    10  push 2:isize
    11  store isize
    12  global_addr g2       ; ဂ
    13  push 2:usize
    14  ptr_add 8
    15  push 3:isize
    16  store isize
    17  global_addr g2       ; ဂ
    18  push 0:usize
    19  ptr_add 8
    20  push 10:isize
    21  store isize
    22  global_addr g2       ; ဂ
    23  push 2:usize
    24  index 3 from 1
    25  ptr_add 8
    26  load isize
    27  print
    28  push 3:usize
    29  print
    30  global_addr g2       ; ဂ
    31  print_list [3]isize
    32  global_addr g0       ; က
    33  global_addr g2       ; ဂ
    34  blit [3]isize
    35  global_addr g0       ; က
    36  global_addr g2       ; ဂ
    37  list_eq [3]isize
    38  print
    39  global_addr g1       ; ခ
    40  global_addr g0       ; က
    41  list_eq [3]isize
    42  not
    43  print
    44  global_addr g3       ; ဇယား
    45  zero [2][3]isize
    46  global_addr g3       ; ဇယား
    47  push 1:usize
    48  ptr_add 24
    49  push 2:usize
    50  ptr_add 8
    51  push 9:isize
    52  store isize
    53  global_addr g3       ; ဇယား
    54  push 0:usize
    55  ptr_add 24
    56  global_addr g2       ; ဂ
    57  blit [3]isize
    58  global_addr g3       ; ဇယား
    59  print_list [2][3]isize
    60  global_addr g4       ; ညွှန်း
    61  global_addr g2       ; ဂ
    62  store &*[3]isize
    63  global_addr g4       ; ညွှန်း
    64  load &*[3]isize
    65  push 1:usize
    66  ptr_add 8
    67  push 20:isize
    68  store isize
    69  global_addr g5       ; ပ
    70  global_addr g2       ; ဂ
    71  push 0:usize
    72  ptr_add 8
    73  store &*isize
    74  global_addr g5       ; ပ
    75  load &*isize
    76  push 2:isize
    77  ptr_add 8
    78  load isize
    79  print
    80  global_addr g2       ; ဂ
    81  call f0              ; ပေါင်း
    82  print
    83  local_addr l0        ; %list
    84  push 4:isize
    85  store isize
    86  local_addr l0        ; %list
    87  push 1:usize
    88  ptr_add 8
    89  push 5:isize
    90  store isize
    91  local_addr l0        ; %list
    92  push 2:usize
    93  ptr_add 8
    94  push 6:isize
    95  store isize
    96  local_addr l0        ; %list
    97  call f0              ; ပေါင်း
    98  print
    99  ret
